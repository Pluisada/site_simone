---
/**
 * Áreas de Atuação — editorial blocks, NOT a card grid.
 * design-system.md §20 (amended 2026-08-16, client-approved),
 * content-positioning-brief.md §5.
 *
 * ARCHITECTURE — two editorial groups, not six peer rows:
 *  - Group 1 "Linguagem, fala e desenvolvimento": the five clinical/
 *    developmental areas, inquiry-priority ordered. Equal visual weight.
 *  - Group 2 "Comunicação profissional": Oratória, alone. Separated from
 *    Group 1 by heading, spacing and a hairline divider only — never by a
 *    special background/card. The grouping distinguishes two different
 *    visitor needs (clinical vs. professional-communication), not a
 *    statement that either group, or Oratória, is more important.
 *
 * HARD RULES (design-system.md §35):
 *  - No uniform six-card grid. No medical icons. No decorative illustration.
 *  - No background tint / radius module on Oratória — it uses the exact
 *    same row treatment as every other area (supersedes the earlier
 *    terracotta-tint rule; see design-system.md §20 amendment).
 *  - Group order and area order within each group are FIXED — see
 *    src/data/practice-areas.ts.
 *  - AFASIA carries identical visual weight to the other four Group 1
 *    areas — same type, spacing and treatment. It must never be visually
 *    downgraded.
 *  - The two group headings share identical typographic treatment — neither
 *    group is allowed to read as more important than the other.
 *
 * HEADING HIERARCHY: H2 (section title) → H3 (group heading) → H4 (area
 * name). H4 keeps the same visual size the area name had as an H3 before
 * this change (see .area__name) — only the semantic level moved down one
 * step to make room for the new group heading.
 *
 * CONTENT: every description is the client's own plain-language wording,
 * verbatim from src/data/practice-areas.ts. Nothing is rewritten into
 * marketing copy; no symptom, outcome, statistic or age range is invented.
 */
import Container from './Container.astro';
import { practiceAreas, practiceAreaGroups, serviceScope } from '../data/practice-areas';
import type { PracticeAreaGroupKey } from '../data/practice-areas';

const groups = (Object.keys(practiceAreaGroups) as PracticeAreaGroupKey[]).map((key) => ({
  key,
  label: practiceAreaGroups[key],
  areas: practiceAreas.filter((area) => area.group === key),
}));
---

<section class="areas" id="areas-de-atuacao" aria-labelledby="areas-title">
  <Container>
    <header class="areas__header">
      <p class="eyebrow">Áreas de Atuação</p>
      <h2 class="areas__title" id="areas-title">
        Em que Simone pode ajudar
      </h2>
    </header>

    {
      groups.map((group, index) => (
        <div
          class:list={['areas__group', index > 0 && 'areas__group--divided']}
          role="group"
          aria-labelledby={`areas-group-${group.key}`}
        >
          <h3 class="areas__group-title" id={`areas-group-${group.key}`}>
            {group.label}
          </h3>

          <ul class="areas__list">
            {group.areas.map((area) => (
              <li class="area" id={area.id}>
                <div class="area__label">
                  <h4 class="area__name">{area.name}</h4>
                  <p class="area__audience">{area.audience}</p>
                </div>
                <div class="area__body">
                  <p class="area__description">{area.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    {/* Validated scope notes (client-validation B1, D1). Kept as plain
        eligibility statements, not claims. */}
    <div class="areas__scope">
      <p>
        <strong>{serviceScope.minimumChildAge}.</strong>{' '}
        {serviceScope.underMinimumAgeNote}.
      </p>
      <p>{serviceScope.onlineEligibility}.</p>
    </div>
  </Container>
</section>

<style>
  .areas {
    padding-block: var(--section-padding-block);
    background-color: var(--color-bg);
    border-block-start: 1px solid var(--color-border);
  }

  .areas__header {
    margin-block-end: var(--space-xl);
  }

  .areas__title {
    margin-block-start: var(--space-2xs);
    max-inline-size: 20ch;
  }

  .areas__group-title {
    margin: 0 0 var(--space-md);
  }

  /* Divider between the two groups: hairline + generous whitespace, per
   * design-system.md §20 — typography/spacing/divider carry the grouping,
   * never a card or background fill. */
  .areas__group--divided {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--color-border);
  }

  .areas__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .area {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block: var(--space-lg);
    border-block-end: 1px solid var(--color-border);
  }

  .area:last-of-type {
    border-block-end: 0;
  }

  .area__name {
    margin: 0;
    /* H4 now (was H3) — same visual size as before, existing tokens only. */
    font-size: var(--font-size-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
  }

  .area__audience {
    margin-block-start: var(--space-3xs);
    font-size: var(--font-size-small);
    line-height: var(--leading-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-muted);
  }

  .area__description {
    color: var(--color-text);
    max-inline-size: 62ch;
  }

  .areas__scope {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--font-size-small);
    line-height: var(--leading-small);
    color: var(--color-text-muted);
    max-inline-size: 62ch;
  }

  .areas__scope strong {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  /* ---- Desktop: narrow label column + wider description column ---- */
  @media (min-width: 1024px) {
    .area {
      display: grid;
      grid-template-columns: 3fr 9fr; /* design-system.md §20 */
      gap: var(--space-xl);
      align-items: start;
      padding-block: var(--space-xl);
    }

    .area__label {
      /* Label column holds its own vertical rhythm against the description. */
      padding-block-start: var(--space-3xs);
    }
  }
</style>
