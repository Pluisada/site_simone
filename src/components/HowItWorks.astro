---
/**
 * Como Funciona — two editorial items (no numbering, no timeline).
 * design-system.md §22, content-positioning-brief.md §8.
 *
 * RESTRUCTURED 2026-08-16 (client-requested, client-approved). Previously a
 * four-step numbered horizontal/vertical timeline. Simone asked for the
 * numbered-timeline presentation to be removed entirely: no 01–04 markers,
 * no circles, no connectors. The two items below replace it — same
 * validated content, regrouped and reordered visually only, never reworded.
 *
 * HARD RULES:
 *  - Exactly two items. No numbering, no timeline connector, no cards.
 *  - Online mechanics stay attached to the second item only.
 *  - No CTA here. The approved strategy has exactly three CTA placements
 *    (hero, after Áreas de Atuação, footer) — adding a fourth would break
 *    design-system.md §15/§35.
 *
 * ACCESSIBILITY: rendered as a <ul> of two <li> — "list, 2 items" is
 * announced by screen readers, satisfying "the reader must perceive two
 * main items" without any extra ARIA. The bullet mark before each title is
 * decorative (CSS ::before), not part of the accessible name.
 *
 * IMAGE COLUMN UPDATE 2026-08-24 (client-approved, design-system.md §27
 * amendment) — SUPERSEDED same day by the photo-insertion audit: a second
 * photo was briefly stacked below the original consultation-room photo on
 * the (incorrect) premise that it showed a different room. Direct
 * file comparison in the audit confirmed consultorio-sala-1067x800.jpg and
 * sala-infantil-4x3.jpg are the SAME physical room, just framed differently
 * — stacking them read as duplicated content, not two distinct spaces.
 * REVERTED to a single image: sala-infantil-4x3.jpg only (tighter, calmer
 * crop of the two). consultorio-sala-1067x800.jpg is no longer used here —
 * see src/data/assets.ts for its updated status.
 */
import { Image } from 'astro:assets';
import Container from './Container.astro';
import { processItems, processSection } from '../data/process';
import roomPhoto from '../assets/images/sala-infantil-4x3.jpg';
---

<section class="how" id="como-funciona" aria-labelledby="how-title">
  <Container>
    <div class="how__header">
      <div class="how__intro">
        <p class="eyebrow">{processSection.eyebrow}</p>
        <h2 class="how__title" id="how-title">{processSection.heading}</h2>
        <p class="how__lead measure">{processSection.lead}</p>
      </div>

      {/* Supporting editorial image — used at native ratio, natural
          background, no overlay. Not a card: no border, no shadow. */}
      <figure class="how__figure">
        <Image
          src={roomPhoto}
          alt={processSection.imageAlt}
          widths={[440, 720, 960]}
          sizes="(min-width: 1024px) 420px, min(440px, 90vw)"
          loading="lazy"
          class="how__image"
        />
      </figure>
    </div>

    <ul class="how-items">
      {
        processItems.map((item, index) => (
          <li
            class:list={['how-item', index > 0 && 'how-item--divided']}
            id={`como-funciona-${item.id}`}
          >
            <h3 class="how-item__title">{item.title}</h3>

            {item.content.map((block) => {
              if (block.type === 'quote') {
                return <p class="how-item__quote">{block.text}</p>;
              }
              if (block.type === 'note') {
                return (
                  <p class="how-item__note">
                    <span class="how-item__note-label">{block.label}:</span>{' '}
                    {block.text}
                  </p>
                );
              }
              return <p class="how-item__paragraph">{block.text}</p>;
            })}
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .how {
    padding-block: var(--section-padding-block);
    /* Back to cream after the warm-sand About block — keeps the alternation
     * reading as rhythm rather than repetition. */
    background-color: var(--color-bg);
  }

  .how__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-block-end: var(--space-2xl);
  }

  .how__title {
    margin-block-start: var(--space-2xs);
    max-inline-size: 18ch;
  }

  .how__lead {
    margin-block-start: var(--space-md);
    color: var(--color-text-muted);
  }

  .how__figure {
    margin: 0;
  }

  .how__image {
    inline-size: min(440px, 90vw);
    block-size: auto;
    border-radius: var(--radius-lg);
  }

  /* ---- Items — editorial list, not a timeline ----
   * Same stacked-block language already used for Áreas de Atuação's two
   * groups (design-system.md §20): full-width blocks, hairline divider,
   * no cards, no forced equal height. */
  .how-items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how-item {
    padding-block: var(--space-lg);
    border-block-end: 1px solid var(--color-border);
  }

  .how-item:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }

  .how-item--divided {
    /* Slightly more generous than the hairline above alone, so the second
     * (much longer) item still reads as its own block. */
    margin-block-start: var(--space-xs);
  }

  .how-item__title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--font-size-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
  }

  /* Decorative bullet mark — replaces the removed numbered circle. Ignored
   * by screen readers (generated content, not real text). */
  .how-item__title::before {
    content: '';
    flex: none;
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background-color: var(--color-terracotta);
  }

  .how-item__quote {
    margin-block-start: var(--space-sm);
    font-style: italic;
    color: var(--color-text-muted);
    max-inline-size: 46ch;
  }

  .how-item__paragraph {
    margin-block-start: var(--space-sm);
    color: var(--color-text);
    max-inline-size: 62ch;
  }

  .how-item__paragraph + .how-item__paragraph {
    margin-block-start: var(--space-md);
  }

  /* Online mechanics — a quiet annotation, marked by a hairline rule rather
   * than a box, so it never reads as a separate track. */
  .how-item__note {
    margin-block-start: var(--space-md);
    padding-inline-start: var(--space-sm);
    border-inline-start: 2px solid var(--color-terracotta);
    font-size: var(--font-size-small);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    max-inline-size: 46ch;
  }

  .how-item__note-label {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  /* ---- Desktop: header keeps its asymmetric text/photo split ---- */
  @media (min-width: 1024px) {
    .how__header {
      display: grid;
      grid-template-columns: 7fr 5fr;
      gap: var(--space-3xl);
      align-items: center;
    }

    .how__figure {
      justify-self: end;
    }

    .how__image {
      inline-size: 420px;
      max-inline-size: 100%;
    }

    .how-item {
      padding-block: var(--space-xl);
    }
  }

  /* ---- Motion: same restrained reveal used elsewhere (design-system.md §31) ---- */
  @media (prefers-reduced-motion: no-preference) {
    .how-item {
      animation: how-item-enter var(--duration-slow) var(--easing-standard) both;
    }
  }

  @keyframes how-item-enter {
    from {
      opacity: 0;
      transform: translateY(var(--distance-reveal));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
