---
/**
 * Contato — final in-page contact block.
 * design-system.md §25 (CTA / Contato footer), §4 (3rd CTA placement).
 *
 * SCOPE: concise entry point only. It does NOT restate credentials, practice
 * areas, testimonials, the Google Reviews module, or the online mechanics
 * already explained in Como Funciona.
 *
 * CTA: this is the THIRD and final approved in-page placement (hero → after
 * Áreas de Atuação → contact/footer). No fourth pattern is introduced.
 *
 * MAP: rendered as a LINK to contact.mapsUrl, not an embedded iframe.
 * design-system.md §25 mentions "address + embedded map", but a Maps embed is
 * a third-party frame that sets cookies and loads external resources — which
 * technical-architecture.md §9/§13 deliberately designed the site to avoid
 * (no third-party scripts, restrictive CSP, LGPD-conscious). The link serves
 * the same navigational purpose with none of that cost. Reported as a
 * deliberate deviation.
 *
 * PHOTO ADDED 2026-08-24 (client-approved, design-system.md §27 amendment):
 * a reception photo sits beside the intro. This section was previously
 * image-free by design — the amendment documents this as a deliberate,
 * one-section exception, not a precedent for Áreas de Atuação (§20) or the
 * Footer (§25), which keep their no-decoration rules.
 *
 * TWO-LAYER COMPOSITION 2026-08-24 (final revision, same-day follow-up).
 * Two earlier attempts at this section's desktop layout are superseded:
 *  1. Photo + full details list stacked in one right-hand column against a
 *     short left column (eyebrow/heading/lead/CTA) — left ~850px of empty
 *     background below the CTA.
 *  2. Sticky-positioning the left column so it tracked the scroll instead
 *     — technically worked, but rejected as the approved solution: the
 *     visual problem is structural (a mismatched-height shared row), not a
 *     scrolling concern, and sticky didn't change the section's own
 *     composition.
 *
 * FINAL: the details list is no longer inside the intro/photo row at all.
 * Two independent layers instead:
 *   Layer 1 — .contact__intro-row: intro text + CTA beside the photo, a
 *     compact row sized by its own (much closer) content heights.
 *   Layer 2 — .details: the WhatsApp/Consultório/Horários/Atendimento
 *     on-line list, full content width, arranged as 4 columns at ≥1024px
 *     (vertical hairline dividers, same border/color as the mobile
 *     horizontal dividers — just rotated to the row's axis) and stacked
 *     on mobile exactly as before.
 * This is why the photo no longer determines the whole section's height —
 * it only sizes Layer 1, which is a much closer match.
 */
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Button from './Button.astro';
import { site, whatsapp, contact } from '../data/site';
import { serviceScope } from '../data/practice-areas';
import { contactSection } from '../data/contact-section';
import { hero } from '../data/hero';
import receptionPhoto from '../assets/images/sources/consultorio-recepcao-v2-1162x1280.jpg';
---

<section class="contact" id="contato" aria-labelledby="contact-title">
  <Container>
    {/* Layer 1 — intro + CTA beside the photo. A compact row, not the
        whole section: see this file's header comment for why the details
        list below is deliberately NOT nested in here. */}
    <div class="contact__intro-row">
      <div class="contact__intro">
        <p class="eyebrow">{contactSection.eyebrow}</p>
        <h2 class="contact__title" id="contact-title">{contactSection.heading}</h2>
        <p class="contact__lead measure">{contactSection.lead}</p>

        {/* data-cta-sentinel sits on the BUTTON, not the section: the
            persistent mobile bar only needs to step aside while this actual
            CTA is on screen. Marking the whole section would hide the bar
            from the top of the FAQ onward (Contact starts peeking in there),
            costing CTA reach across a section where visitors are resolving
            objections. */}
        <div class="contact__cta" data-cta-sentinel>
          <Button whatsapp ariaLabel={`Conversar no WhatsApp com ${site.name}`}>
            {hero.ctaLabel}
          </Button>
        </div>
      </div>

      {/* Supporting editorial image — native ratio, no overlay, no card
          (design-system.md §27, 2026-08-24 amendment). */}
      <figure class="contact__figure">
        <Image
          src={receptionPhoto}
          alt={contactSection.photoAlt}
          widths={[440, 720, 1162]}
          sizes="(min-width: 1024px) 420px, min(440px, 90vw)"
          loading="lazy"
          class="contact__image"
        />
      </figure>
    </div>

    {/* Layer 2 — contact details, full content width. 4 columns with
        vertical dividers at ≥1024px, stacked with horizontal dividers
        below that (same border token either way — see .details__item). */}
    <dl class="details">
      <div class="details__item">
        <dt class="details__label">{contactSection.labelWhatsapp}</dt>
        <dd class="details__value">
          <a class="details__link tabular" href={whatsapp.href} target="_blank" rel="noopener noreferrer">
            {whatsapp.displayNumber}
          </a>
        </dd>
      </div>

      <div class="details__item">
        <dt class="details__label">{contactSection.labelAddress}</dt>
        <dd class="details__value">
          <address class="details__address">
            {contact.addressStreet}<br />
            {contact.addressBuilding}<br />
            {contact.addressDistrict}, {contact.addressLocality} — {contact.addressRegion}
          </address>
          <a class="details__link" href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">
            {contactSection.mapLinkText}
          </a>
        </dd>
      </div>

      <div class="details__item">
        <dt class="details__label">{contactSection.labelHours}</dt>
        <dd class="details__value">{contact.hoursHuman}</dd>
      </div>

      <div class="details__item">
        <dt class="details__label">{contactSection.labelOnline}</dt>
        <dd class="details__value">{serviceScope.onlineEligibility}</dd>
      </div>
    </dl>
  </Container>
</section>

<style>
  .contact {
    padding-block: var(--section-padding-block);
    /* Cream, continuing the alternation after the warm-sand FAQ. */
    background-color: var(--color-bg);
  }

  /* ---- Layer 1: intro + CTA beside the photo ---- */
  .contact__intro-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .contact__title {
    margin-block-start: var(--space-2xs);
  }

  .contact__lead {
    margin-block-start: var(--space-md);
    color: var(--color-text);
  }

  .contact__cta {
    margin-block-start: var(--space-lg);
  }

  /* Reception photo (design-system.md §27, 2026-08-24 amendment). */
  .contact__figure {
    margin: 0;
  }

  .contact__image {
    inline-size: min(440px, 90vw);
    block-size: auto;
    border-radius: var(--radius-lg);
  }

  /* ---- Layer 2: contact details, full content width ---- */
  .details {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    /* Separates this layer from Layer 1 above — see this file's header
     * comment for why the details list no longer lives inside the
     * intro/photo row. */
    margin-block-start: var(--space-2xl);
  }

  .details__item {
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
  }

  .details__label {
    font-family: var(--font-body);
    font-size: var(--font-size-eyebrow);
    line-height: var(--leading-eyebrow);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .details__value {
    margin: var(--space-2xs) 0 0;
    font-size: var(--font-size-small);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .details__address {
    font-style: normal;
  }

  .details__link {
    display: inline-flex;
    align-items: center;
    /* Comfortable target without becoming a button. */
    min-block-size: var(--target-min);
    font-weight: var(--font-weight-medium);
  }

  .details__item:nth-child(2) .details__link {
    margin-block-start: var(--space-2xs);
  }

  @media (min-width: 1024px) {
    /* Layer 1: text+CTA beside the photo, sized by ITS OWN (much closer)
     * content heights — the photo no longer shares a row with the details
     * list, so this row's height mismatch is modest, not ~800px. */
    .contact__intro-row {
      display: grid;
      /* Same asymmetric proportion family used elsewhere on the page. */
      grid-template-columns: 7fr 5fr;
      gap: var(--space-3xl);
      align-items: center;
    }

    /* Layer 2: 4 columns, single row, vertical hairline dividers instead
     * of the mobile stack's horizontal ones — same border token, rotated
     * to the row's axis, not a new visual element. */
    .details {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0 var(--space-xl);
      margin-block-start: var(--space-2xl);
    }

    .details__item {
      padding-block-start: 0;
      border-block-start: none;
      padding-inline-start: var(--space-xl);
      border-inline-start: 1px solid var(--color-border);
    }

    .details__item:first-child {
      padding-inline-start: 0;
      border-inline-start: none;
    }
  }
</style>
