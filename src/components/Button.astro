---
/**
 * Button — the single primary CTA treatment, plus one secondary/ghost variant.
 * design-system.md §15.
 *
 * HARD RULES (design-system.md §35, fixed):
 *  - The primary variant is the WhatsApp CTA and must look IDENTICAL at all
 *    three placements (hero, after Áreas de Atuação, footer) and in the mobile
 *    CTA bar. Never restyle per context.
 *  - No third button style. No pill radius. No box-shadow at any state.
 *  - Hover changes color only — no scale, no translate, no shadow.
 */
import { whatsapp } from '../data/site';

interface Props {
  variant?: 'primary' | 'ghost';
  /** Renders the WhatsApp glyph and defaults href to the centralized deep link. */
  whatsapp?: boolean;
  href?: string;
  fullWidth?: boolean;
  /** Accessible label — required when the visible text alone is ambiguous. */
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  whatsapp: isWhatsapp = false,
  href,
  fullWidth = false,
  ariaLabel,
  class: className,
} = Astro.props;

const resolvedHref = href ?? (isWhatsapp ? whatsapp.href : '#');

// External links get safe rel attributes.
const isExternal = resolvedHref.startsWith('http');
---

<a
  href={resolvedHref}
  aria-label={ariaLabel}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class:list={[
    'button',
    `button--${variant}`,
    fullWidth && 'button--full',
    className,
  ]}
>
  {
    isWhatsapp && (
      <svg
        class="button__icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
        />
      </svg>
    )
  }
  <span><slot /></span>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-height: var(--target-comfortable); /* 48px — clears the 44px floor */
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--font-size-button);
    line-height: var(--leading-button);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-button);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--easing-standard),
      color var(--duration-fast) var(--easing-standard);
  }

  .button--primary {
    padding: var(--space-xs) var(--space-md);
    background-color: var(--color-cta);
    color: var(--color-on-primary);
    /* No box-shadow — design-system.md §14/§15 */
  }

  .button--primary:hover {
    background-color: var(--color-cta-hover);
    color: var(--color-on-primary);
  }

  .button--ghost {
    padding: var(--space-2xs) 0;
    background-color: transparent;
    color: var(--color-link);
    font-weight: var(--font-weight-medium);
    min-height: var(--target-min);
  }

  .button--ghost:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .button--full {
    width: 100%;
  }

  .button__icon {
    flex: none;
  }

  @media (min-width: 1024px) {
    .button--primary {
      padding: var(--space-xs) 1.75rem; /* 14px 28px per design-system.md §15 */
    }
  }
</style>
