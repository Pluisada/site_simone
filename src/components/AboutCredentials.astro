---
/**
 * Quem é Simone — portrait + credentials as ONE cohesive composition.
 * design-system.md §21, content-positioning-brief.md §7.
 *
 * HARD RULES:
 *  - Portrait and credentials form a single unit. NOT a "photo card" plus a
 *    "credentials card" — there is no card, border or shadow anywhere here.
 *  - Three-tier hierarchy, descending prominence:
 *      1. CFFa specialist registrations (Fraunces, largest)
 *      2. Formação / PUC-SP (Inter, medium)
 *      3. Pós-graduações (Inter, small + muted, ONE wrapped line with ·
 *         separators — never five bulleted lines; this is the specific
 *         mechanism that prevents a résumé wall)
 *  - Registration numbers: small, muted, tabular, never accent-coloured and
 *    never styled as a statistic callout.
 *  - No invented biography. The client declined a personal narrative (F2).
 *  - CFFa verification link renders ONLY if the URL actually exists; it is
 *    currently null and must stay that way until the client supplies it.
 */
import { Image } from 'astro:assets';
import Container from './Container.astro';
import { credentials, contact } from '../data/site';
import { about } from '../data/about';
// Contextual portrait (576×720) — deliberately a DIFFERENT photograph from
// the Hero's. See src/data/assets.ts for provenance and status.
import portrait from '../assets/images/about-portrait-4x5.jpg';
---

<section class="about" id="sobre" aria-labelledby="about-title">
  <Container>
    <div class="about__grid">
      {/* Portrait column — offset downward on desktop so the composition
          staggers rather than reading as a symmetrical two-up template. */}
      <figure class="about__figure">
        <Image
          src={portrait}
          alt={about.portraitAlt}
          widths={[280, 360, 576]}
          sizes="(min-width: 1024px) 320px, min(280px, 70vw)"
          loading="lazy"
          class="about__portrait"
        />
      </figure>

      <div class="about__content">
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 class="about__title" id="about-title">{about.heading}</h2>
        <p class="about__lead measure">{about.lead}</p>

        <div class="credentials">
          {/* ---- TIER 1 — CFFa specialist registrations ---- */}
          <div class="tier tier--primary">
            <h3 class="tier__label">{about.tier1Label}</h3>
            <ul class="tier__list">
              {
                credentials.cffaSpecializations.map((item) => (
                  <li class="cffa">
                    <p class="cffa__title">{item.title}</p>
                    {/* The issuing council is stated once in the tier label
                        above, so `item.body` is deliberately not repeated per
                        item — it appeared three times in five lines and added
                        noise to the credential block. Only the registration
                        number is shown here. */}
                    <p class="cffa__meta">
                      <span class="cffa__number tabular">{item.registration}</span>
                    </p>
                  </li>
                ))
              }
            </ul>

            {/* Renders only when the client supplies the real URL.
                Currently null — do not invent one. */}
            {
              credentials.verificationUrl && (
                <a class="tier__verify" href={credentials.verificationUrl}>
                  Consultar registro no site do CFFa
                </a>
              )
            }
          </div>

          {/* ---- TIER 2 — Formação ---- */}
          <div class="tier">
            <h3 class="tier__label">{about.tier2Label}</h3>
            <p class="formation">
              {credentials.formation.degree}
              <span class="formation__institution">
                {credentials.formation.institution}
              </span>
            </p>
          </div>

          {/* ---- TIER 3 — Pós-graduações, compact single wrapped line ---- */}
          <div class="tier">
            <h3 class="tier__label">{about.tier3Label}</h3>
            <p class="postgrad">
              {
                credentials.postgraduate.map((item, index) => (
                  <>
                    {index > 0 && (
                      <span class="postgrad__sep" aria-hidden="true">
                        ·
                      </span>
                    )}
                    <span>{item}</span>
                  </>
                ))
              }
            </p>
          </div>
        </div>

        {/*
          Google Reviews — external credibility signal.
          design-system.md §23: a compact inline link placed adjacent to the
          credentials block, NOT its own section and NOT a testimonial module.

          Deliberately absent (no validated data exists for any of them):
          star rating, review count, quoted excerpts, screenshots.
          The star icon is stroke-only and unfilled precisely so it cannot be
          read as a rating.

          Destination is the existing Google listing already used on the
          current site (client-validation H1).
        */}
        <p class="reviews">
          <a class="reviews__link" href={contact.mapsUrl} target="_blank" rel="noopener noreferrer">
            <svg
              class="reviews__icon"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M12 3.5l2.6 5.3 5.9.85-4.25 4.15 1 5.85L12 16.9l-5.25 2.75 1-5.85L3.5 9.65l5.9-.85z"
              ></path>
            </svg>
            <span>Veja as avaliações no Google</span>
          </a>
        </p>
      </div>
    </div>
  </Container>
</section>

<style>
  .about {
    padding-block: var(--section-padding-block);
    /* Warm-sand separates this block from the cream Áreas section above
     * without needing a divider (design-system.md §4 alternation). */
    background-color: var(--color-bg-alt);
  }

  .about__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .about__figure {
    margin: 0;
  }

  .about__portrait {
    inline-size: min(280px, 70vw);
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .about__title {
    margin-block-start: var(--space-2xs);
  }

  .about__lead {
    margin-block-start: var(--space-md);
    color: var(--color-text);
  }

  /* ---- Credentials ---- */
  .credentials {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-block-start: var(--space-xl);
  }

  .tier__label {
    /* Tier labels are structural, not headline-scale: small uppercase in
     * Inter so they never compete with the credential values themselves. */
    font-family: var(--font-body);
    font-size: var(--font-size-eyebrow);
    line-height: var(--leading-eyebrow);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2xs);
  }

  .tier__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* TIER 1 — most prominent. Fraunces gives the CFFa titles the weight the
   * hierarchy calls for without a card, badge or accent colour. */
  .cffa__title {
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    line-height: var(--leading-h3);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .cffa__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    margin-block-start: var(--space-3xs);
    font-size: var(--font-size-small);
    line-height: var(--leading-small);
    color: var(--color-text-muted);
  }

  /* Registration number: understated and tabular — never an accent-coloured
   * or oversized statistic callout (design-system.md §6). */
  .cffa__number {
    font-size: var(--font-size-credential);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-muted);
  }

  .tier__verify {
    display: inline-block;
    margin-block-start: var(--space-sm);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
  }

  /* TIER 2 — clearly below Tier 1, clearly above Tier 3. */
  .formation {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .formation__institution {
    font-weight: var(--font-weight-regular);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  /* TIER 3 — deliberately the quietest tier: one wrapped line, small and
   * muted, so five long titles can never overpower the CFFa block. */
  .postgrad {
    font-size: var(--font-size-small);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    max-inline-size: 62ch;
  }

  .postgrad__sep {
    color: var(--color-terracotta);
    padding-inline: var(--space-3xs);
  }

  /* ---- Google Reviews: content-hugging link, no panel, no card ---- */
  .reviews {
    margin-block-start: var(--space-lg);
  }

  .reviews__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    /* Comfortable target without turning the link into a button. */
    min-block-size: var(--target-min);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-primary-light);
    text-underline-offset: 0.2em;
  }

  .reviews__link:hover {
    color: var(--color-link-hover);
    text-decoration-color: currentColor;
  }

  .reviews__icon {
    flex: none;
  }

  /* ---- Desktop: staggered asymmetric composition ---- */
  @media (min-width: 1024px) {
    .about__grid {
      display: grid;
      /* Narrow portrait column against a wider content column — not a
       * symmetrical 50/50 photo-left/text-right template. */
      grid-template-columns: 4fr 8fr;
      gap: var(--space-3xl);
      align-items: start;
    }

    .about__portrait {
      inline-size: 320px;
      max-inline-size: 100%;
    }

    .about__figure {
      /* Vertical stagger: the portrait drops below the heading baseline so
       * the two zones interlock rather than sitting in a neat row. */
      padding-block-start: var(--space-2xl);
    }
  }
</style>
